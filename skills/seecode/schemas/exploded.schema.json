{
  "title": "Exploded view",
  "required": [
    "parts"
  ],
  "additionalProperties": false,
  "properties": {
    "parts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 28
          },
          {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 28
              },
              "sub": {
                "type": "string",
                "maxLength": 36
              },
              "w": {
                "type": "number",
                "minimum": 24,
                "maximum": 800
              },
              "d": {
                "type": "number",
                "minimum": 24,
                "maximum": 800
              },
              "t": {
                "type": "number",
                "minimum": 2,
                "maximum": 120
              },
              "r": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 400
                  },
                  {
                    "enum": [
                      "round",
                      "inherit"
                    ]
                  }
                ]
              },
              "x": {
                "type": "number",
                "minimum": -800,
                "maximum": 800
              },
              "y": {
                "type": "number",
                "minimum": -800,
                "maximum": 800
              },
              "level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "focal": {
                "type": "boolean"
              },
              "kind": {
                "enum": [
                  "slab",
                  "screen",
                  "display",
                  "terminal",
                  "board",
                  "pcb",
                  "battery",
                  "plate",
                  "keys",
                  "switches",
                  "cards",
                  "chip",
                  "studs",
                  "speaker",
                  "lid",
                  "vault",
                  "bun",
                  "house",
                  "housing",
                  "tray",
                  "desk",
                  "table",
                  "counter",
                  "post",
                  "rack",
                  "building"
                ]
              },
              "hollow": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 200
                  }
                ]
              },
              "rings": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/item"
                }
              },
              "side": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "$ref": "#/$defs/side"
                }
              },
              "top": {
                "enum": [
                  "dome",
                  "gable",
                  "hip",
                  "shed"
                ]
              },
              "topH": {
                "type": "number",
                "minimum": 1,
                "maximum": 400
              }
            }
          }
        ]
      }
    },
    "w": {
      "type": "number",
      "minimum": 24,
      "maximum": 800
    },
    "d": {
      "type": "number",
      "minimum": 24,
      "maximum": 800
    },
    "gap": {
      "type": "number",
      "minimum": 8,
      "maximum": 600
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "panel",
            "hole",
            "ring",
            "lines",
            "text",
            "dots"
          ]
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 2
          }
        },
        "at": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 2
          }
        },
        "size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 2
          }
        },
        "r": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 400
            },
            {
              "enum": [
                "round",
                "inherit"
              ]
            }
          ]
        },
        "h": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 200
        },
        "tone": {
          "enum": [
            "light",
            "dark",
            "black",
            "accent",
            "mid",
            "cut",
            "line",
            "text"
          ]
        },
        "repeat": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            }
          ]
        },
        "fill": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "dir": {
          "enum": [
            "h",
            "v"
          ]
        },
        "dash": {
          "type": "boolean"
        },
        "ragged": {
          "type": "boolean"
        },
        "rings": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "top": {
          "enum": [
            "dome",
            "gable",
            "hip",
            "shed"
          ]
        },
        "topH": {
          "type": "number",
          "minimum": 1,
          "maximum": 400
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "face": {
          "enum": [
            "left",
            "right",
            "both"
          ]
        },
        "shape": {
          "enum": [
            "panel",
            "lines",
            "text",
            "button"
          ]
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 2
          }
        },
        "repeat": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            }
          ]
        },
        "fill": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "dir": {
          "enum": [
            "h",
            "v"
          ]
        },
        "dash": {
          "type": "boolean"
        },
        "tone": {
          "enum": [
            "light",
            "dark",
            "black",
            "accent",
            "mid",
            "cut",
            "line",
            "text"
          ]
        }
      }
    }
  }
}
