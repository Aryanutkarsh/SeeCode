        },
        "fill": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "dir": {
          "enum": [
            "h",
            "v"
          ]
        },
        "dash": {
          "type": "boolean"
        },
        "tone": {
          "enum": [
            "light",
