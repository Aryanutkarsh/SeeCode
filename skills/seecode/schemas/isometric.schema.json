              "label": {
                "type": "string",
                "maxLength": 28
              },
              "sub": {
                "type": "string",
                "maxLength": 36
              },
              "from": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -4000,
                  "maximum": 4000
                }
              },
              "to": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -4000,
                  "maximum": 4000
                }
              },
              "thick": {
                "type": "number",
                "minimum": 1,
                "maximum": 80
              },
              "tone": {
                "enum": [
                  "light",
                  "dark",
                  "accent"
                ]
              },
              "focal": {
                "type": "boolean"
              }
            }
          },
          {
