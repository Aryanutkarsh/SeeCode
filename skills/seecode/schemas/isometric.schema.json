                "type": "number",
                "minimum": -4000,
                "maximum": 4000
              },
              "z": {
                "type": "number",
                "minimum": -4000,
                "maximum": 4000
              },
              "w": {
                "type": "number",
                "minimum": 1,
                "maximum": 2000
              },
              "d": {
                "type": "number",
                "minimum": 1,
                "maximum": 2000
