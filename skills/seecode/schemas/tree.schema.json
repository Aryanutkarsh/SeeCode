{
  "title": "Tree / org chart",
  "required": ["root"],
  "additionalProperties": false,
  "properties": {
    "dir": { "enum": ["TB", "LR"] },
    "root": { "$ref": "#/$defs/tnode" }
  },
  "$defs": {
    "tnode": {
      "type": "object", "required": ["label"], "additionalProperties": false,
      "properties": {
        "icon": { "enum": ["calendar", "clock", "person", "people", "briefcase", "home", "money", "card", "cart", "document", "flag", "check", "mail", "phone", "chat", "plane", "car", "heart", "star", "moon", "sun", "gift", "pin", "key", "server", "database", "cloud", "lock", "code", "gear"] },
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
        "label": { "type": "string", "maxLength": 36 },
        "sub": { "type": "string", "maxLength": 40 },
        "tag": { "type": "string", "maxLength": 8 },
        "kind": { "enum": ["backend", "focal", "store", "external", "input", "optional", "security", "muted"] },
        "focal": { "type": "boolean" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/tnode" } }
      }
    }
  }
}
